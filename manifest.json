        }
      ]
    },
    {
      "name": "Global Score",
      "short_name": "Score",
      "description": "View your complete environment intelligence score",
      "url": "/intelligence/scoreboard.html",
      "icons": [
        {
          "src": "/assets/images/icons/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
