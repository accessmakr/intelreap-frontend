  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://intelreap.com/manifest.json"
    }
  ],
  "share_target": {
    "action": "/intelligence.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+intelreap",
      "url": "/intelligence.html?q=%s"
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 480
  }
}
